[Unit]
Description=Garden Tracker (harvest + weather log)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garden
Group=garden
WorkingDirectory=/opt/garden

# Overrides live here (chmod 600, owned by garden). See garden.env.example.
# Leading '-' = don't fail if the file is missing.
EnvironmentFile=-/etc/garden/garden.env
Environment=HOME=/home/garden

# Open live-update (SSE) streams never finish on their own, so cap how long
# shutdown waits for them; otherwise every restart stalls until systemd kills it.
ExecStart=/opt/garden/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --timeout-graceful-shutdown 3
Restart=always
RestartSec=3

# Light hardening. ProtectSystem=full keeps /usr /boot /etc read-only while
# leaving /opt (app + data) writable.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
# Port 80 is privileged; grant just the bind capability instead of running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
