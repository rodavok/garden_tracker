# Garden Tracker service environment.
# Copy to /etc/garden/garden.env, then:  chmod 600  &&  chown garden:garden
# systemd reads this via EnvironmentFile= in garden.service.
# Everything here is optional; the defaults are baked into app/config.py.

# --- Weather location (first-run defaults only; edit later in Settings) -------
#GARDEN_LAT=43.0203
#GARDEN_LON=-78.8803
#GARDEN_LOCATION=Tonawanda, New York
#GARDEN_TZ=America/New_York

# Earliest date the one-time weather backfill reaches back to.
#GARDEN_BACKFILL_START=2025-08-01

# Local hour (0-23) for the daily weather refresh.
#GARDEN_WEATHER_HOUR=6

# Set to 0 to disable outbound Open-Meteo calls entirely (manual entry still works).
#GARDEN_WEATHER=1

# --- Optional: store data outside the app dir (e.g. on a mounted volume) ------
#GARDEN_DATA=/opt/garden/data
#GARDEN_DB=/opt/garden/data/garden.db
